<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
        Couleurs FIXES (marque). Les couleurs de THÈME (fond, surfaces, textes...) sont injectées
        dynamiquement par Services/ThemeService.cs et utilisées en {DynamicResource ...} :
        Bg, Surface, Surface2, Surface3, BorderColor, TextPrimary, TextSecondary, TextMuted,
        Accent, AccentSoft, OnAccent, Success(Soft), Warning(Soft), Info(Soft), Danger(Soft), Overlay, TabBarColor
    -->

    <Color x:Key="Primary">#FF8A3D</Color>
    <Color x:Key="PrimaryDark">#E8702A</Color>
    <Color x:Key="PrimaryDarkText">#1A0E05</Color>
    <Color x:Key="Secondary">#20242C</Color>
    <Color x:Key="SecondaryDarkText">#A6ACB8</Color>
    <Color x:Key="Tertiary">#5AA9FF</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Red">#FF5C6C</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#0E1014</Color>

    <!-- Valeurs initiales du thème (remplacées au démarrage par ThemeService) -->
    <Color x:Key="Bg">#0E1014</Color>
    <Color x:Key="Surface">#171A20</Color>
    <Color x:Key="Surface2">#20242C</Color>
    <Color x:Key="Surface3">#2A2F39</Color>
    <Color x:Key="BorderColor">#2B303A</Color>
    <Color x:Key="TextPrimary">#ECEEF2</Color>
    <Color x:Key="TextSecondary">#A6ACB8</Color>
    <Color x:Key="TextMuted">#6E7582</Color>
    <Color x:Key="Accent">#FF8A3D</Color>
    <Color x:Key="AccentSoft">#33FF8A3D</Color>
    <Color x:Key="OnAccent">#1A0E05</Color>
    <Color x:Key="Success">#3DD68C</Color>
    <Color x:Key="SuccessSoft">#263DD68C</Color>
    <Color x:Key="Warning">#F5B544</Color>
    <Color x:Key="WarningSoft">#26F5B544</Color>
    <Color x:Key="Info">#5AA9FF</Color>
    <Color x:Key="InfoSoft">#265AA9FF</Color>
    <Color x:Key="Danger">#FF5C6C</Color>
    <Color x:Key="DangerSoft">#26FF5C6C</Color>
    <Color x:Key="Overlay">#B3000000</Color>
    <Color x:Key="TabBarColor">#13161B</Color>

    <Thickness x:Key="HeaderPadding">12,8,12,6</Thickness>
    <x:Double x:Key="TopInset">8</x:Double>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>
