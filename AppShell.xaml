<?xml version="1.0" encoding="utf-8" ?>
<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Rss_feeder_prout.Views"
    x:Class="Rss_feeder_prout.AppShell"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="{DynamicResource Bg}"
    Shell.ForegroundColor="{DynamicResource TextPrimary}"
    Shell.TitleColor="{DynamicResource TextPrimary}"
    Shell.UnselectedColor="{DynamicResource TextMuted}"
    Shell.TabBarBackgroundColor="{DynamicResource TabBarColor}"
    Shell.TabBarForegroundColor="{DynamicResource Accent}"
    Shell.TabBarTitleColor="{DynamicResource Accent}"
    Shell.TabBarUnselectedColor="{DynamicResource TextMuted}">

    <!--
        Navigation par onglets en bas (plus naturelle sur mobile) :
        Accueil · Recherche · Favoris · Archives · Plus
        Les autres pages (catégorie, articles, lecteur, gestion…) s'ouvrent par-dessus avec retour.
    -->
    <TabBar>
        <Tab Title="Accueil" Icon="tab_home.png" Route="hometab">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="Recherche" Icon="tab_search.png" Route="searchtab">
            <ShellContent ContentTemplate="{DataTemplate local:SearchPage}" Route="SearchPage" />
        </Tab>

        <Tab Title="Favoris" Icon="tab_star.png" Route="favoritestab">
            <ShellContent ContentTemplate="{DataTemplate local:FavoritesPage}" Route="FavoritesPage" />
        </Tab>

        <Tab Title="Archives" Icon="tab_archive.png" Route="archivestab">
            <ShellContent ContentTemplate="{DataTemplate local:ArchivePage}" Route="ArchivePage" />
        </Tab>

        <Tab Title="Plus" Icon="tab_more.png" Route="moretab">
            <ShellContent ContentTemplate="{DataTemplate local:MorePage}" Route="MorePage" />
        </Tab>
    </TabBar>

</Shell>
