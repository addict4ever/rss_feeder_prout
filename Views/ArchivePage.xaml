<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Rss_feeder_prout.ViewModels"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.ArchivePage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="{DynamicResource HeaderPadding}" Spacing="10">
            <Grid ColumnDefinitions="*,Auto" Margin="4,6,0,0">
                <VerticalStackLayout Spacing="0">
                    <Label Text="Archives" Style="{StaticResource PageTitle}" />
                    <Label Text="{Binding CountText}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
                <controls:IconButton Grid.Column="1" Icon="upload" Command="{Binding ExportCommand}" VerticalOptions="End" />
            </Grid>
            <Border Style="{StaticResource SearchField}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:IconView Icon="search" Color="{DynamicResource TextMuted}" Size="18" />
                    <Entry Grid.Column="1" Placeholder="Rechercher dans les archives…" Text="{Binding SearchText}" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding ArchivedItems}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <SwipeView Margin="14,5" BackgroundColor="Transparent">
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Supprimer"
                                               BackgroundColor="{DynamicResource Danger}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchiveViewModel}}, Path=DeleteArchiveCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchiveViewModel}}, Path=OpenArchiveCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <HorizontalStackLayout Grid.Row="0" Spacing="7">
                                        <Border WidthRequest="18" HeightRequest="18" StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="{DynamicResource Surface3}">
                                            <Label Text="{Binding SiteInitial}" FontSize="10" FontFamily="OpenSansSemibold" TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="{Binding SiteName}" Style="{StaticResource CaptionStrong}" VerticalOptions="Center" MaxLines="1" />
                                        <Label Text="·" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Label Text="{Binding ArchivedText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <controls:IconButton Grid.Row="0" Grid.Column="1" Icon="more-v" IsFlat="True" Size="30" IconSize="16" IconColor="{DynamicResource TextMuted}"
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ArchiveViewModel}}, Path=ArchiveMenuCommand}"
                                                         CommandParameter="{Binding .}" />

                                    <Label Grid.Row="1" Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" MaxLines="3" LineBreakMode="TailTruncation" />

                                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" IsVisible="{Binding HasThumb}" WidthRequest="70" HeightRequest="70"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Surface2}" VerticalOptions="Start">
                                        <Image Source="{Binding ThumbSource}" Aspect="AspectFill" />
                                    </Border>

                                    <Label Grid.Row="2" Text="{Binding PreviewText}" Style="{StaticResource Body}" FontSize="13.5" MaxLines="2" LineBreakMode="TailTruncation" />

                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Inset}" Padding="10,6" IsVisible="{Binding HasNote}">
                                        <HorizontalStackLayout Spacing="8">
                                            <controls:IconView Icon="edit" Size="14" Color="{DynamicResource Accent}" />
                                            <Label Text="{Binding Note}" FontSize="13" TextColor="{DynamicResource TextSecondary}" MaxLines="2" LineBreakMode="TailTruncation" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,60" Spacing="10">
                        <controls:IconView Icon="archive" Size="46" Color="{DynamicResource TextMuted}" />
                        <Label Text="Aucune archive" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                        <Label Text="Les articles archivés depuis le lecteur sont conservés ici pour toujours, même après le nettoyage automatique."
                               Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
