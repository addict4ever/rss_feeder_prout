<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Rss_feeder_prout.ViewModels"
    xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
    x:Class="Rss_feeder_prout.Views.MainPage"
    Shell.NavBarIsVisible="False">

    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding AllPlaylists}" SelectionMode="None">

            <!-- ============ EN-TÊTE : salutation, synchro, flux intelligents ============ -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="{DynamicResource HeaderPadding}" Spacing="0">

                    <!-- Barre du haut -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="4,6,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding TodayText}" Style="{StaticResource Caption}" />
                            <Label Text="{Binding Greeting}" Style="{StaticResource Display}" />
                        </VerticalStackLayout>
                        <controls:IconButton Grid.Column="1" Icon="search" Command="{Binding OpenSearchCommand}" />
                        <controls:IconButton Grid.Column="2" Icon="sync" Command="{Binding FullGlobalSyncCommand}" IconColor="{DynamicResource Accent}" />
                    </Grid>

                    <Label Text="{Binding HeroText}" Style="{StaticResource Body}" FontSize="16" Margin="4,6,4,14" />

                    <!-- Hors connexion -->
                    <Border IsVisible="{Binding IsOffline}" Style="{StaticResource Inset}" BackgroundColor="{DynamicResource WarningSoft}" Margin="0,0,0,10">
                        <HorizontalStackLayout Spacing="10">
                            <controls:IconView Icon="wifi" Color="{DynamicResource Warning}" Size="18" />
                            <Label Text="Hors connexion — les articles hors-ligne restent lisibles." TextColor="{DynamicResource Warning}" FontSize="13.5" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Bandeau de synchro (non bloquant) -->
                    <controls:SyncBannerView Margin="-14,0" />

                    <!-- Carte synchro -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,2,0,0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border Grid.Column="0" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 14" BackgroundColor="{DynamicResource AccentSoft}" VerticalOptions="Center">
                                <controls:IconView Icon="rss" Color="{DynamicResource Accent}" Size="22" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding LastSyncText}" Style="{StaticResource CardTitle}" FontSize="15" />
                                <Label Text="{Binding NextSyncText}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Synchroniser" Style="{StaticResource PrimaryButton}" HeightRequest="42"
                                    Padding="16,0" FontSize="14" Command="{Binding FullGlobalSyncCommand}"
                                    IsEnabled="{Binding Sync.IsIdle}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Flux intelligents -->
                    <Label Text="Mes lectures" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="Unread" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="mail-unread" Color="{DynamicResource Accent}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountUnreadText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Non lus" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="Today" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="today" Color="{DynamicResource Info}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountTodayText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Aujourd'hui" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="All" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="inbox" Color="{DynamicResource TextSecondary}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountAllText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Tous" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="Favorites" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="star" Color="{DynamicResource Warning}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountFavoritesText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Favoris" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="ReadLater" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="bookmark" Color="{DynamicResource Info}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountReadLaterText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Plus tard" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Tile}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSmartCommand}" CommandParameter="Downloaded" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <controls:IconView Icon="check-circle" Color="{DynamicResource Success}" Size="20" HorizontalOptions="Start" />
                                <Label Text="{Binding CountDownloadedText}" Style="{StaticResource BigNumber}" FontSize="22" />
                                <Label Text="Hors-ligne" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Titre des catégories -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="Catégories" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Gérer" Style="{StaticResource GhostButton}" FontSize="13"
                                Command="{Binding NavigateToPlaylistsCommand}" VerticalOptions="Center" Margin="0,10,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- ============ CATÉGORIES ============ -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="12,5" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=OpenPlaylistCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14" Padding="14,14,8,14">
                            <Border Grid.Column="0" WidthRequest="46" HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 15"
                                    BackgroundColor="{Binding AccentColor}" VerticalOptions="Center">
                                <Label Text="{Binding Initial}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#1A0E05"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding SubtitleText}" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" BackgroundColor="{DynamicResource AccentSoft}" IsVisible="{Binding HasUnread}" Padding="10,4">
                                <Label Text="{Binding UnreadText}" FontFamily="OpenSansSemibold" FontSize="12.5" TextColor="{DynamicResource Accent}" />
                            </Border>
                            <controls:IconButton Grid.Column="3" Icon="more-v" IsFlat="True" Size="36" IconSize="18" IconColor="{DynamicResource TextMuted}"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=PlaylistMenuCommand}"
                                                 CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center">
                    <controls:IconView Icon="folder" Size="44" Color="{DynamicResource TextMuted}" />
                    <Label Text="Aucune catégorie" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                    <Label Text="Créez une catégorie et ajoutez-y vos sites préférés." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    <Button Text="Ajouter des sources" Style="{StaticResource PrimaryButton}" Command="{Binding NavigateToPlaylistsCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
