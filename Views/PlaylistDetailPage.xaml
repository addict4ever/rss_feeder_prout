<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Rss_feeder_prout.ViewModels"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.PlaylistDetailPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- En-tête -->
        <Grid Grid.Row="0" Padding="{DynamicResource HeaderPadding}" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <controls:IconButton Grid.Column="0" Icon="back" Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" />
                <Label Text="{Binding SitesCountText}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <controls:IconButton Grid.Column="2" Icon="edit" Command="{Binding RenameCommand}" />
            <controls:IconButton Grid.Column="3" Icon="pulse" IconColor="{DynamicResource Success}" Command="{Binding TestAllCommand}" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Sites}" SelectionMode="None">

            <CollectionView.Header>
                <VerticalStackLayout Padding="14,0,14,6" Spacing="10">

                    <!-- Ajout d'une source -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Ajouter une source" Style="{StaticResource CardTitle}" />
                            <Label Text="Collez l'adresse d'un site OU d'un flux : le flux RSS / Atom est trouvé automatiquement."
                                   Style="{StaticResource Caption}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource SearchField}">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <controls:IconView Icon="link" Color="{DynamicResource TextMuted}" Size="18" />
                                        <Entry Grid.Column="1" Placeholder="ex. : korben.info" Text="{Binding NewUrlText}"
                                               Keyboard="Url" ReturnType="Go" ReturnCommand="{Binding AddSiteCommand}" />
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Text="Ajouter" Style="{StaticResource PrimaryButton}" HeightRequest="46"
                                        Padding="18,0" Command="{Binding AddSiteCommand}" />
                            </Grid>
                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsBusy}">
                                <ActivityIndicator IsRunning="{Binding IsBusy}" WidthRequest="16" HeightRequest="16" />
                                <Label Text="{Binding StatusText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Synchro de la catégorie -->
                    <Border Style="{StaticResource Card}" Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Inclure dans la synchronisation" Style="{StaticResource CardTitle}" FontSize="15" />
                                <Label Text="« Tout synchroniser » et synchro automatique" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding CurrentPlaylist.IsActive}" Toggled="OnActiveToggled" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Sources · touchez pour modifier, tester ou déplacer" Style="{StaticResource SectionTitle}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="14,4" BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem Text="Supprimer"
                                           BackgroundColor="{DynamicResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistDetailViewModel}}, Path=DeleteSiteCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource Card}" Padding="12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistDetailViewModel}}, Path=EditSiteCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid WidthRequest="42" HeightRequest="42" VerticalOptions="Center">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource Surface2}">
                                        <Label Text="{Binding Initial}" FontFamily="OpenSansSemibold" FontSize="17"
                                               TextColor="{DynamicResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasIcon}" BackgroundColor="White" Padding="5">
                                        <Image Source="{Binding DisplayIcon}" Aspect="AspectFit" />
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" FontSize="15" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Host}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Ellipse WidthRequest="7" HeightRequest="7" Fill="{Binding HealthColor}" VerticalOptions="Center" />
                                        <Label Text="{Binding HealthText}" FontSize="11.5" TextColor="{Binding HealthColor}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Grid Grid.Column="2" VerticalOptions="Center">
                                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="18" HeightRequest="18" />
                                    <Label Text="{Binding CountText}" Style="{StaticResource Caption}" FontSize="11.5" IsVisible="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="8">
                    <controls:IconView Icon="rss" Size="40" Color="{DynamicResource TextMuted}" />
                    <Label Text="Aucune source pour l'instant" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </Grid>
</ContentPage>
