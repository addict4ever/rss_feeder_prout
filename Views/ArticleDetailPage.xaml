<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.ArticleDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Barre du haut -->
        <Grid Grid.Row="0" Padding="{DynamicResource HeaderPadding}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <controls:IconButton Grid.Column="0" Icon="back" Command="{Binding BackCommand}" />
            <Label Grid.Column="1" Text="{Binding PositionText}" Style="{StaticResource Caption}" VerticalOptions="Center" HorizontalOptions="Center" />
            <controls:IconButton Grid.Column="2" Icon="text-size" Command="{Binding ReaderSettingsCommand}" />
            <controls:IconButton Grid.Column="3" Icon="share" Command="{Binding ShareCommand}" />
            <controls:IconButton Grid.Column="4" Icon="more-v" Command="{Binding MoreCommand}" />
        </Grid>

        <!-- Récupération en cours -->
        <Border Grid.Row="1" Style="{StaticResource Inset}" Margin="14,0,14,4" BackgroundColor="{DynamicResource Surface2}" IsVisible="{Binding IsLoadingContent}">
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsRunning="{Binding IsLoadingContent}" WidthRequest="16" HeightRequest="16" />
                <Label Text="{Binding LoadingText}" Style="{StaticResource Caption}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Contenu (page HTML complète : en-tête, image, texte) -->
        <WebView Grid.Row="2" x:Name="ReaderWebView" Source="{Binding HtmlSource}" BackgroundColor="Transparent"
                 Navigating="OnWebViewNavigating" />

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />

        <!-- Barre d'actions du bas -->
        <Border Grid.Row="3" BackgroundColor="{DynamicResource TabBarColor}" StrokeThickness="0" Padding="10,8,10,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <controls:IconButton Grid.Column="0" Icon="chevron-left" IsFlat="True" Command="{Binding PreviousCommand}" IsVisible="{Binding HasNavigation}" />
                <controls:IconButton Grid.Column="1" Icon="chevron-right" IsFlat="True" Command="{Binding NextCommand}" IsVisible="{Binding HasNavigation}" />

                <Button Grid.Column="2" Text="{Binding SaveText}" Style="{StaticResource SmallButton}"
                        BackgroundColor="{DynamicResource SuccessSoft}" TextColor="{DynamicResource Success}"
                        Command="{Binding DownloadContentCommand}" IsVisible="{Binding CanSave}"
                        HorizontalOptions="Center" Padding="14,6" />

                <controls:IconButton Grid.Column="3" Icon="{Binding SpeakIcon}" IsFlat="True" Command="{Binding SpeakCommand}" />
                <controls:IconButton Grid.Column="4" Icon="bookmark" IsFlat="True" Filled="{Binding IsReadLater}" IconColor="{Binding ReadLaterColor}" Command="{Binding ReadLaterCommand}" />
                <controls:IconButton Grid.Column="5" Icon="star" IsFlat="True" Filled="{Binding IsFavorite}" IconColor="{Binding FavoriteColor}" Command="{Binding FavoriteCommand}" />
                <controls:IconButton Grid.Column="6" Icon="globe" IsFlat="True" Command="{Binding OpenExternalCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
