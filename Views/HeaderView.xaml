<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Rss_feeder_prout.Views.HeaderView">

    <!-- La mascotte d'origine (le smiley). Touchez-la : elle change d'humeur ! -->
    <Grid BackgroundColor="Transparent">
        <Grid x:Name="MenuButton"
              HorizontalOptions="End"
              VerticalOptions="Center"
              HeightRequest="70"
              WidthRequest="70">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuButtonClicked" />
            </Grid.GestureRecognizers>

            <Ellipse Fill="#FFD23F" Stroke="#1A0E05" StrokeThickness="2" />

            <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Start" Margin="0,18,0,0" Spacing="12">
                <Ellipse Fill="#1A0E05" HeightRequest="8" WidthRequest="8" />
                <Ellipse Fill="#1A0E05" HeightRequest="8" WidthRequest="8" />
            </HorizontalStackLayout>

            <Path x:Name="SmileyMouth"
                  Data="M 20,45 Q 35,60 50,45"
                  Stroke="#1A0E05"
                  StrokeThickness="3"
                  StrokeLineCap="Round"
                  HorizontalOptions="Center" />

            <Grid.Shadow>
                <Shadow Brush="Black" Offset="3,4" Radius="10" Opacity="0.25" />
            </Grid.Shadow>
        </Grid>
    </Grid>
</ContentView>
