<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Rss_feeder_prout.ViewModels"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.DatabaseManagerPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" Padding="{DynamicResource HeaderPadding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <controls:IconButton Grid.Column="0" Icon="back" Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" TextColor="{DynamicResource Accent}" />
            </VerticalStackLayout>
            <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" WidthRequest="22" HeightRequest="22" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14,0,14,30" Spacing="0">

                <!-- ================= STOCKAGE ================= -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Espace utilisé" Style="{StaticResource Caption}" />
                                <Label Text="{Binding TotalText}" Style="{StaticResource BigNumber}" />
                            </VerticalStackLayout>
                            <controls:IconButton Grid.Column="1" Icon="refresh" Command="{Binding RefreshDbListCommand}" />
                        </Grid>

                        <!-- Barre de répartition -->
                        <Grid x:Name="UsageBar" HeightRequest="10" ColumnSpacing="2" ColumnDefinitions="*,*,*,*">
                            <BoxView Grid.Column="0" Color="{DynamicResource Accent}" CornerRadius="4" />
                            <BoxView Grid.Column="1" Color="{DynamicResource Info}" CornerRadius="4" />
                            <BoxView Grid.Column="2" Color="{DynamicResource Success}" CornerRadius="4" />
                            <BoxView Grid.Column="3" Color="{DynamicResource Warning}" CornerRadius="4" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8"><Ellipse Fill="{DynamicResource Accent}" WidthRequest="9" HeightRequest="9" VerticalOptions="Center" /><Label Text="Bases de données :" Style="{StaticResource Caption}" /><Label Text="{Binding DatabasesText}" Style="{StaticResource CaptionStrong}" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><Ellipse Fill="{DynamicResource Info}" WidthRequest="9" HeightRequest="9" VerticalOptions="Center" /><Label Text="Images :" Style="{StaticResource Caption}" /><Label Text="{Binding ImagesText}" Style="{StaticResource CaptionStrong}" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><Ellipse Fill="{DynamicResource Success}" WidthRequest="9" HeightRequest="9" VerticalOptions="Center" /><Label Text="Sauvegardes :" Style="{StaticResource Caption}" /><Label Text="{Binding BackupsText}" Style="{StaticResource CaptionStrong}" /></HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="8"><Ellipse Fill="{DynamicResource Warning}" WidthRequest="9" HeightRequest="9" VerticalOptions="Center" /><Label Text="Archives par mois :" Style="{StaticResource Caption}" /><Label Text="{Binding ColdText}" Style="{StaticResource CaptionStrong}" /></HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Label Text="{Binding ArticlesText}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ================= SAUVEGARDE ================= -->
                <Label Text="Sauvegarde &amp; restauration" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Inclure les articles" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding BackupArticles}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Inclure les images hors-ligne" />
                                <Label Text="Sauvegarde plus lourde, mais 100 % hors-ligne après restauration" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding BackupImages}" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Text="Compression" VerticalOptions="Center" />
                            <Picker Grid.Column="1" ItemsSource="{Binding CompressionChoices}" SelectedIndex="{Binding CompressionIndex}" WidthRequest="150" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Sauvegarde automatique" />
                                <Label Text="Chaque semaine, les 5 dernières sont gardées" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding AutoBackupEnabled}" VerticalOptions="Center" />
                        </Grid>
                        <Button Text="Créer une sauvegarde" Style="{StaticResource PrimaryButton}" Command="{Binding CreateBackupCommand}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Importer…" Style="{StaticResource SecondaryButton}" Command="{Binding ImportDbCommand}" />
                            <Button Grid.Column="1" Text="Exporter…" Style="{StaticResource SecondaryButton}" Command="{Binding ExportDbCommand}" />
                        </Grid>
                        <Label Text="Importer accepte : sauvegarde .zip (nouvelle ou ancienne version), base .db3 (fusion sans doublons) et fichier .opml."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Sauvegardes disponibles · touchez pour restaurer" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasBackups}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Backups}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DatabaseManagerViewModel}}, Path=BackupMenuCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="{DynamicResource SuccessSoft}">
                                        <controls:IconView Icon="zip" Color="{DynamicResource Success}" Size="20" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding DateText}" FontFamily="OpenSansSemibold" FontSize="14.5" />
                                        <Label Text="{Binding Label}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource CaptionStrong}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ================= MAINTENANCE ================= -->
                <Label Text="Maintenance" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource CardTight}">
                    <VerticalStackLayout>
                        <controls:MenuRowView Icon="compress" Title="Compacter les bases" Subtitle="Récupère l'espace libéré (VACUUM + optimisation)" Command="{Binding VacuumCommand}" />
                        <BoxView Style="{StaticResource Divider}" Margin="68,0,0,0" />
                        <controls:MenuRowView Icon="check-circle" Title="Vérifier l'intégrité" Subtitle="Contrôle les 3 bases" Accent="{DynamicResource Success}" Command="{Binding IntegrityCommand}" />
                        <BoxView Style="{StaticResource Divider}" Margin="68,0,0,0" />
                        <controls:MenuRowView Icon="archive" Title="Archiver les anciens articles" Subtitle="Déplacés par mois dans des fichiers séparés (compressés)" Accent="{DynamicResource Warning}" Command="{Binding ColdArchiveCommand}" />
                        <BoxView Style="{StaticResource Divider}" Margin="68,0,0,0" />
                        <controls:MenuRowView Icon="image" Title="Vider le cache d'images" Accent="{DynamicResource Info}" Command="{Binding ClearImagesCommand}" />
                        <BoxView Style="{StaticResource Divider}" Margin="68,0,0,0" />
                        <controls:MenuRowView Icon="broom" Title="Supprimer les images inutilisées" Subtitle="Images d'articles déjà supprimés" Accent="{DynamicResource Info}" Command="{Binding OrphanImagesCommand}" />
                        <BoxView Style="{StaticResource Divider}" Margin="68,0,0,0" />
                        <controls:MenuRowView Icon="upload" Title="Exporter les articles" Subtitle="JSON (tous, favoris, hors-ligne)" Accent="{DynamicResource TextSecondary}" Command="{Binding ExportArticlesCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Archives par mois" Style="{StaticResource SectionTitle}" IsVisible="{Binding HasColdArchives}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ColdArchives}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DatabaseManagerViewModel}}, Path=ColdMenuCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="14" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    </VerticalStackLayout>
                                    <controls:IconView Grid.Column="1" Icon="chevron-right" Size="16" Color="{DynamicResource TextMuted}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- ================= NETTOYAGE ================= -->
                <Label Text="Nettoyage des articles (favoris toujours conservés)" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Supprimer les articles de plus de…" Style="{StaticResource Caption}" />
                        <FlexLayout Wrap="Wrap" JustifyContent="Start">
                            <controls:ChipView Text="1 jour" Margin="0,0,8,8" Command="{Binding CleanDatabaseCommand}" CommandParameter="1d" />
                            <controls:ChipView Text="3 jours" Margin="0,0,8,8" Command="{Binding CleanDatabaseCommand}" CommandParameter="3d" />
                            <controls:ChipView Text="7 jours" Margin="0,0,8,8" Command="{Binding CleanDatabaseCommand}" CommandParameter="7d" />
                            <controls:ChipView Text="1 mois" Margin="0,0,8,8" Command="{Binding CleanDatabaseCommand}" CommandParameter="1m" />
                            <controls:ChipView Text="3 mois" Margin="0,0,8,8" Command="{Binding CleanDatabaseCommand}" CommandParameter="3m" />
                        </FlexLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Articles lus" Style="{StaticResource SecondaryButton}" FontSize="13.5" Command="{Binding CleanDatabaseCommand}" CommandParameter="ReadOnly" />
                            <Button Grid.Column="1" Text="Archives + 6 mois" Style="{StaticResource SecondaryButton}" FontSize="13.5" Command="{Binding CleanDatabaseCommand}" CommandParameter="Archive6m" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ================= FICHIERS ================= -->
                <Label Text="Fichiers de base de données" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource Card}" Padding="14,8">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DatabaseFiles}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,8">
                                    <controls:IconView Icon="database" Size="18" Color="{DynamicResource TextMuted}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" FontSize="13.5" />
                                        <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
                <Button Text="Supprimer les anciennes bases migrées" Style="{StaticResource GhostButton}" FontSize="13" Command="{Binding DeleteLegacyCommand}" Margin="0,6,0,0" />

                <!-- ================= ZONE CRITIQUE ================= -->
                <Label Text="Zone critique" Style="{StaticResource SectionTitle}" TextColor="{DynamicResource Danger}" />
                <Border Style="{StaticResource Card}" Stroke="{DynamicResource DangerSoft}">
                    <VerticalStackLayout Spacing="10">
                        <Button Text="Vider tous les articles" Style="{StaticResource DangerButton}" Command="{Binding ClearAllArticlesCommand}" />
                        <Button Text="Réinitialiser toute la base" Style="{StaticResource DangerButton}" BackgroundColor="{DynamicResource Danger}" TextColor="White" Command="{Binding DeleteDbCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
