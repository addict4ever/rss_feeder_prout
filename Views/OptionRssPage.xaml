<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rss_feeder_prout.Views.OptionRssPage"
             Title="Options RSS">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Frame BackgroundColor="{AppThemeBinding Light=#F0F0F0, Dark=#2C2C2C}" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mise a jour automatique" 
                           FontSize="18" 
                           FontAttributes="Bold" />

                    <Label Text="Choisir intervalle de synchronisation :" 
                           FontSize="14" 
                           TextColor="Gray" />

                    <Picker x:Name="IntervalPicker" 
                            Title="Selectionner un intervalle"
                            SelectedIndexChanged="OnIntervalChanged" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>