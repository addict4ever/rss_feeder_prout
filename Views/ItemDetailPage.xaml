<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.ItemDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!-- Page web d'origine dans l'application -->
    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="{DynamicResource HeaderPadding}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
            <controls:IconButton Grid.Column="0" Icon="close" Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" FontSize="15" />
                <Label Text="{Binding Host}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <controls:IconButton Grid.Column="2" Icon="refresh" Clicked="OnReloadClicked" />
            <controls:IconButton Grid.Column="3" Icon="share" Command="{Binding ShareCommand}" />
            <controls:IconButton Grid.Column="4" Icon="browser" Command="{Binding OpenExternalCommand}" />
        </Grid>

        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" IsVisible="{Binding IsLoadingPage}" HeightRequest="3" />

        <WebView Grid.Row="2" x:Name="PageWebView" Navigated="OnNavigated" Navigating="OnNavigating" />
    </Grid>
</ContentPage>
