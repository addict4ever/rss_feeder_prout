<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Rss_feeder_prout.ViewModels"
             xmlns:controls="clr-namespace:Rss_feeder_prout.Controls"
             x:Class="Rss_feeder_prout.Views.PlaylistManagerPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- En-tête -->
        <Grid Grid.Row="0" Padding="{DynamicResource HeaderPadding}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <controls:IconButton Grid.Column="0" Icon="back" Command="{Binding BackCommand}" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0">
                <Label Text="{Binding Title}" Style="{StaticResource HeaderTitle}" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
            <controls:IconButton Grid.Column="2" Icon="sync" IconColor="{DynamicResource Accent}" Command="{Binding SyncAllCommand}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1" Padding="14,0,14,8" Spacing="10">
            <Border Style="{StaticResource SearchField}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <controls:IconView Icon="search" Color="{DynamicResource TextMuted}" Size="18" />
                    <Entry Grid.Column="1" Placeholder="Rechercher une catégorie…" Text="{Binding SearchText}" ClearButtonVisibility="WhileEditing" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Importer OPML" Style="{StaticResource SecondaryButton}" FontSize="13.5" Command="{Binding ImportOpmlCommand}" />
                <Button Grid.Column="1" Text="Exporter OPML" Style="{StaticResource SecondaryButton}" FontSize="13.5" Command="{Binding ExportOpmlCommand}" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredPlaylists}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Margin="14,5" BackgroundColor="Transparent">
                        <SwipeView.RightItems>
                            <SwipeItems>
                                <SwipeItem Text="Supprimer"
                                           BackgroundColor="{DynamicResource Danger}"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistManagerViewModel}}, Path=DeletePlaylistCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Border Style="{StaticResource Card}" Padding="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistManagerViewModel}}, Path=EditPlaylistCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Padding="14,12,6,12">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                        BackgroundColor="{Binding AccentColor}" VerticalOptions="Center">
                                    <Label Text="{Binding Initial}" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#1A0E05"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                    <Label Text="{Binding SubtitleText}" Style="{StaticResource Caption}" />
                                </VerticalStackLayout>
                                <controls:IconButton Grid.Column="2" Icon="more-v" IsFlat="True" Size="36" IconSize="18" IconColor="{DynamicResource TextMuted}"
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlaylistManagerViewModel}}, Path=PlaylistMenuCommand}"
                                                     CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="10">
                    <controls:IconView Icon="folder" Size="44" Color="{DynamicResource TextMuted}" />
                    <Label Text="Aucune catégorie trouvée" Style="{StaticResource CardTitle}" HorizontalOptions="Center" />
                    <Label Text="Ajoutez une catégorie ou importez un fichier OPML." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <Button Grid.Row="3" Text="+  Nouvelle catégorie" Style="{StaticResource PrimaryButton}" Margin="14,8,14,14"
                Command="{Binding AddPlaylistCommand}" />

        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
